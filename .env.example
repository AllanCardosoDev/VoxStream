# Variáveis de ambiente do VoxStream
# Copie este arquivo para .env e preencha os valores

# Aceitar os termos de serviço do Coqui TTS (obrigatório)
COQUI_TOS_AGREED=1

# Dispositivo para inferência do modelo: "cpu" ou "cuda"
TTS_DEVICE=cpu

# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
